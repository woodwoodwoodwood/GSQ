 main.py                            | 67 ++++++++++++++++--------
 2 files changed, 129 insertions(+), 28 deletions(-)
 create mode 100644 configs/qwen36/qwen36_35B_A3B.yaml

diff --git a/configs/qwen36/qwen36_35B_A3B.yaml b/configs/qwen36/qwen36_35B_A3B.yaml
new file mode 100644
index 0000000..b3d5f72
--- /dev/null
+++ b/configs/qwen36/qwen36_35B_A3B.yaml
@@ -0,0 +1,90 @@
+# Production config — Qwen3.6-35B-A3B (MoE)
+# Uses paths relative to the working directory; set GSQ_RUNTIME in .env/shell if artifacts should leave the repo (see scripts/_common.sh).
+#
+# Model: Qwen/Qwen3.6-35B-A3B  (model_type: qwen3_5_moe)
+#   IMPORTANT: Qwen3.6 reuses the SAME architecture / model_type as Qwen3.5
+#   (qwen3_5_moe, arch Qwen3_5MoeForConditionalGeneration), so it is served by
+#   the existing Qwen35* wrappers (src/models/qwen35_moe_dist.py for the
+#   multi-GPU expert-parallel path). Confirmed via the public config.json:
+#   - 256 routed experts, 8 active per token (+ 1 shared expert)
+#   - 40 decoder layers, hidden_size=2048
+#   - Hybrid attention: layer_types — 30x "linear_attention" (GatedDeltaNet)
+#     + 10x "full_attention" (every 4th layer; full_attention_interval=4)
+#   - Shared expert per layer: shared_expert + shared_expert_gate (sigmoid gated)
+#   - Expert weights: 3D fused tensors gate_up_proj[E, 2*I, H] / down_proj[E, H, I]
+#   - moe_intermediate_size=512, shared_expert_intermediate_size=512
+#   - Multimodal shell: top-level config has text_config + vision_config; GSQ
+#     builds the text CausalLM from text_config and bridges the checkpoint's
+#     ".language_model.*" keys via BaseModelWrapper._ckpt_to_model_name.
+#
+# NOTE: Requires transformers >= 5.3.0 for Qwen3.5/3.6 MoE (qwen3_5_moe) support.
+#
+# Multi-GPU expert-parallel routing (main.get_model_wrapper):
+#   world_size > 1  -> Qwen35MoeDistributedWrapper  (recommended; full MoE expert quant)
+#   world_size == 1 -> Qwen35MoeWrapper             (single-GPU MoE expert quant is
+#                                                    incomplete; use the _dist path)
+#
+# Scaling guidance (4 GPUs/node):
+#   1 node  ( 4 GPUs) — 64 experts/GPU
+#   2 nodes ( 8 GPUs) — 32 experts/GPU
+#   4 nodes (16 GPUs) — 16 experts/GPU
+#
+# Serving (vLLM) TP constraint for Marlin WNA16 fused MoE with groupsize=128:
+#   (moe_intermediate_size / TP) % max(64, group_size) == 0  ->  (512 / TP) % 128 == 0
+#   => valid TP_SIZE in {1, 2, 4} (max 4). scripts/serve_model.sh auto-clamps TP.
+
+model:
+  name: "Qwen/Qwen3.6-35B-A3B"
+  device: "cuda"
+  dtype: "bfloat16"
+
+data:
+  dataset_name: "open_thoughts"
+  batch_size: 64
+  num_samples: 4096
+  max_length: 4096
+  num_workers: 8
+  val_samples: 128
+
+quantization:
+  gsq_bits: 2
+  init_method: "gptq"
+  gsq_enabled: true
+  start_layer: 0
+  self_attn: false
+  std: 0.01
+  temperature: [2, 0.05]
+  scale: [100, 500]
+  groupsize: 128
+  strength: 6
+  logits_dtype: "bfloat16"   # "float32" for higher precision logits (more memory)
+
+training:
+  num_epochs: 10
+  device_microbatch_size: 4
+  masks_lr: 0.0002
+  signs_lr: 0.0001
+  scales_lr: 0.0001
+  weight_decay: 1.0
+  checkpoint_dir: "checkpoints/qwen36-35b"
+  log_dir: "logs/qwen36-35b"
+  act_cache_dir: "cache/act_cache"
+  eval_baseline: true
+  # ppl_eval_every_n_layers: 6
+
+gptq:
+  nsamples: 512
+  wbits: 2
+  sym: true
+  trits: false
+  percdamp: 0.1
+  blocksize: 128
+  groupsize: 128
+  static_groups: false
+  prunen: 0
+  prunem: 0
+
+wandb:
+  enabled: false
+  entity: "ist"
+  project: "GSQ-multi"
